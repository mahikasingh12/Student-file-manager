# 1. Check project files
ls

# 2. Initialize Git repository
git init

# 3. Configure Git
git config --global user.name "Your Name"
git config --global user.email "your-email@gmail.com"

# 4. Stage initial project files
git add .

# 5. Create initial commit
git commit -m "Initial commit - Library Management"

# 6. Modify an existing file and save it

# 7. Stage changes
git add .

# 8. Create second commit
git commit -m "Updated library management files"

# 9. Modify another existing file and save it

# 10. Create third commit
git add .
git commit -m "Added new library features"

# 11. View complete commit history
git log

# 12. View compact commit history
git log --oneline

# 13. View file-specific commit history
git log --oneline -- filename

# 14. Make another modification and save the file (do not stage it)

# 15. View unstaged changes
git diff

# 16. Stage changes
git add .

# 17. View staged changes
git diff --staged

# 18. View comparison between two commits
git diff HEAD~2 HEAD

# 19. Compare a specific file between two commits
git diff HEAD~2 HEAD -- filename

# 20. View details of the latest commit
git show

# 21. Final repository status
git status
