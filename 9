public class LoginTest {
    private WebDriver driver;

    @BeforeEach
    public void setUp() {
        // TODO 1: Create ChromeOptions and configure the browser if required.
        ChromeOptions options=new ChromeOptions();
        // TODO 2: Initialize the ChromeDriver.
        driver=new ChromeDriver(options);
        // TODO 3: Maximize the browser window.
        driver.manage().window().maximize();
        // TODO 4: Open the supplied login application.
        //
        // Hint:
        // Path page = Paths.get("webapp", "index.html").toAbsolutePath();
        // driver.get(page.toUri().toString());
        Path page = Paths.get("webapp", "index.html").toAbsolutePath();
        driver.get(page.toUri().toString());
    }

    @Test
    public void validLoginShouldShowSuccessMessage() throws Exception {
        // TODO 5: Locate the username field (id: username) and enter valid credentials.
        driver.findElement(By.id("username")).sendKeys("student");
        // TODO 6: Locate the password field (id: password) and enter valid credentials.
        driver.findElement(By.id("password")).sendKeys("Selenium@123");
        // TODO 7: Click the login button (id: loginBtn).
        driver.findElement(By.id("loginBtn")).click();
        // TODO 8: Retrieve the response message (id: message).
        String message = driver.findElement(By.id("message")).getText();
        // TODO 9: Assert that the success message is displayed.
        assertTrue(driver.findElement(By.id("message")).isDisplayed());
        assertEquals("Login successful!", message);
        // TODO 10: Capture a screenshot named successful-login.png in screenshots/.
        saveScreenshot("successful-login.png");
    }

    @Test
    public void invalidLoginShouldShowErrorMessage() throws Exception {
        // TODO 11: Enter invalid username/password and click the login button.
        driver.findElement(By.id("username")).sendKeys("wronguser");
        driver.findElement(By.id("password")).sendKeys("wrongpass");
        driver.findElement(By.id("loginBtn")).click();

        // TODO 12: Retrieve the response message and assert the error message.
        String message = driver.findElement(By.id("message")).getText();
        assertTrue(driver.findElement(By.id("message")).isDisplayed());
        assertEquals("Invalid username or password!", message);
        
        // TODO 13: Capture a screenshot named invalid-login.png in screenshots/.
        saveScreenshot("invalid-login.png");
        
    }

    private void saveScreenshot(String fileName) throws Exception {
        // TODO 14: Capture the current browser screen and save it in screenshots/.
        // Hint:
        // File source = ((TakesScreenshot) driver).getScreenshotAs(OutputType.FILE);
        // File destination = new File("screenshots/" + fileName);
        // FileHandler.copy(source, destination);
        File source = ((TakesScreenshot) driver)
                      .getScreenshotAs(OutputType.FILE);
        File destination = new File("screenshots/" + fileName);
        FileHandler.copy(source, destination);
    }

    @AfterEach
    public void tearDown() {
        // TODO 15: Close the browser safely if it was initialized.
         if (driver != null) {
            driver.quit();
        }
    }
}
